{
  "manifest_version": 3,
  "name": "myDealz Filter",
  "version": "1.0.1",
  "description": "Filter myDealz postings by keywords in titles. Hide unwanted deals and show the number of hidden postings.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://mydealz.de/*",
    "*://*.mydealz.de/*"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "myDealz Filter",
    "default_icon": {
      "48": "icons/icon-48-grey.png",
      "96": "icons/icon-96-grey.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://mydealz.de/*",
        "*://*.mydealz.de/*"
      ],
      "js": [
        "src/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  }
}
